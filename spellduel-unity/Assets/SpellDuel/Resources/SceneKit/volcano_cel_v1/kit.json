  "units": "metres",
  "up": "+Y",
  "forward": "+Z",
  "gridCell": 4.0,
  "pivot": "bottom centre on the ground unless the part says otherwise",
  "placement": {
    "wall_straight": "pivot = foot centre; walkable face toward +Z; ends at x=+-2 are low boulder saddles (~2.5-3 m) that overlap the neighbour by up to 0.35 m; middles rise to 4.6-5.9 m",
    "wall_corner_out": "convex corner: pivot at the corner point, faces +Z (x in [-2,0]) and +X (z in [-2,0]), taller tower at the corner, mass at x<=0,z<=0",
    "wall_corner_in": "concave corner: filler block at x<=0,z<=0 with faces +Z and +X plus scree in the +X+Z crease; the adjoining straight walls overlap it",
    "wall_end": "foot centre; joins a wall on its -X side, collapsed boulders toward +X; use scale.x=-1 for the mirrored end",
    "gate": "gate_frame + gate_door share the pivot at the ground centre of the opening; door closed at identity; translate gate_door by -y to sink it; gate_frame_<v>.fbx / gate_door_<v>.fbx are the same meshes as separate files",
    "cave_entrance": "pivot at the ground centre of the mouth; opening faces +Z; irregular mouth ~3.3 m wide / ~3.7 m high with an overhanging lip, fallen pillars and scree at both sides; tunnel runs to z=-7",
    "backdrop_rock": "bottom centre, front faces +Z, back faces removed; place outside the map and yaw toward the players"
  },
