        "timeoutSeconds": 1200
      },
      {
        "apiVersion": 1,
        "requestId": "spellduel-002-volcano-kit-v2-validate",
        "action": "validate",
        "configFile": "E:/AI接案/rpg-world-builder/dungeon.volcano.painted.json",
        "timeoutSeconds": 1200
      },
      {
        "apiVersion": 1,
        "requestId": "spellduel-002-volcano-kit-v2-generate",
        "action": "generate",
        "configFile": "E:/AI接案/rpg-world-builder/dungeon.volcano.painted.json",
        "outputFolder": "E:/AI接案/rpg-world-builder/runs/spellduel-volcano-kit-002",
        "timeoutSeconds": 1200
      },
      {
        "apiVersion": 1,
        "requestId": "spellduel-002-volcano-kit-v2-inspect",
        "action": "inspect",
        "outputFolder": "E:/AI接案/rpg-world-builder/runs/spellduel-volcano-kit-002",
        "timeoutSeconds": 1200
      }
    ]
  },
  "kitBuilder": {
